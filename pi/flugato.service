[Unit]
Description=flugato network tester
After=lldpd.service NetworkManager.service

[Service]
WorkingDirectory=/opt/flugato
# fail fast on dead DNS servers; keep tool output in English for the parsers
Environment="RES_OPTIONS=timeout:1 attempts:1" LC_ALL=C
ExecStart=/usr/bin/python3 -m flugato
# undo an inline bridge even after a crash, before Restart= starts the app again
ExecStopPost=-/usr/bin/python3 -m flugato.inline cleanup
# and a Wi-Fi hotspot: the Pi must never stay an access point with no way back home
ExecStopPost=-/usr/bin/python3 -m flugato.hotspot cleanup
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
